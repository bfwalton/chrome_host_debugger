{
  "manifest_version": 3,
  "name": "Local Host Router",
  "version": "1.0",
  "description": "Route chosen domains (HTTP) to localhost ports, no hosts file needed.",
  "permissions": ["proxy", "storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Local Host Router" }
}
