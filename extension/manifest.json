{
  "manifest_version": 3,
  "name": "Local Host Router",
  "version": "1.0",
  "description": "Route chosen domains (HTTP and HTTPS) to local Docker ports via a local proxy.",
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Host Router"
  }
}
